[Unit]
Description=Buzz managed agent %i (buzz-backend-ssh)
After=network-online.target

[Service]
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/buzz-agent-run %i
StandardOutput=append:%h/buzz-agents/%i.log
StandardError=append:%h/buzz-agents/%i.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
